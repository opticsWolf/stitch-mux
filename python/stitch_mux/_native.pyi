from typing import Any

class Session:
    def view(self) -> dict[str, Any]: ...
    def input_text(self, text: str) -> None: ...
    def input_bytes(self, bytes: bytes) -> None: ...
    def key(self, code: str, modifiers: int = 0, text: str | None = None) -> None: ...
    def resize(self, cols: int, rows: int) -> None: ...
    def focus(self, pane_id: int) -> None: ...
    def set_layout(self, root: dict[str, Any], base_revision: int) -> None: ...
    def capture(
        self,
        pane_id: int,
        start: int = 0,
        lines: int = 200,
        format: str = "text",
    ) -> dict[str, Any]: ...
    def is_alive(self) -> bool: ...
    def detach(self) -> None: ...

def connect(socket: str | None = None) -> dict[str, Any]: ...
def attach(
    session: str,
    cols: int = 80,
    rows: int = 24,
    socket: str | None = None,
) -> Session: ...
def list_sessions(socket: str | None = None) -> list[dict[str, Any]]: ...
def capture(
    pane_id: int,
    start: int = 0,
    lines: int = 200,
    format: str = "text",
    socket: str | None = None,
) -> dict[str, Any]: ...
